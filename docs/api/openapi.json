{
  "openapi": "3.1.0",
  "info": {
    "title": "Escuelita de Verano",
    "description": "API de administracion de la escuelita de verano del club sede.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginRespuesta"
                }
              }
            }
          },
          "401": {
            "description": "Usuario o contraseña incorrectos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "detail": "Usuario o contraseña incorrectos."
                }
              }
            }
          },
          "403": {
            "description": "Usuario bloqueado. Pedile a un Admin que blanquee tu contraseña.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "detail": "Usuario bloqueado. Pedile a un Admin que blanquee tu contraseña."
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/yo": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Yo",
        "operationId": "yo_api_v1_auth_yo_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioActual"
                }
              }
            }
          },
          "401": {
            "description": "Sesión inválida o vencida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "detail": "Sesión inválida o vencida."
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/salud": {
      "get": {
        "tags": [
          "infraestructura"
        ],
        "summary": "Salud",
        "operationId": "salud_salud_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Salud Salud Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginEntrada": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginEntrada"
      },
      "LoginRespuesta": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioActual"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "usuario"
        ],
        "title": "LoginRespuesta"
      },
      "MensajeError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "MensajeError",
        "description": "Un rechazo con `detail` en castellano, que src/lib/api.ts muestra tal\ncual."
      },
      "RolUsuario": {
        "type": "string",
        "enum": [
          "admin",
          "coordinador",
          "profesor"
        ],
        "title": "RolUsuario"
      },
      "UsuarioActual": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "apellido": {
            "type": "string",
            "title": "Apellido"
          },
          "rol": {
            "$ref": "#/components/schemas/RolUsuario"
          },
          "debe_cambiar_password": {
            "type": "boolean",
            "title": "Debe Cambiar Password"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "nombre",
          "apellido",
          "rol",
          "debe_cambiar_password"
        ],
        "title": "UsuarioActual",
        "description": "El usuario que acaba de ingresar, tal como lo ve el mismo. Sin hash\nni contador de intentos."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
