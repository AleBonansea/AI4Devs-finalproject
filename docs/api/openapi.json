{
  "openapi": "3.1.0",
  "info": {
    "title": "Escuelita de Verano",
    "description": "API de administracion de la escuelita de verano del club sede.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginRespuesta"
                }
              }
            }
          },
          "401": {
            "description": "Usuario o contraseña incorrectos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "detail": "Usuario o contraseña incorrectos."
                }
              }
            }
          },
          "403": {
            "description": "Usuario bloqueado. Pedile a un Admin que blanquee tu contraseña.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "detail": "Usuario bloqueado. Pedile a un Admin que blanquee tu contraseña."
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/yo": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Yo",
        "operationId": "yo_api_v1_auth_yo_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioActual"
                }
              }
            }
          },
          "401": {
            "description": "Sesión inválida o vencida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                },
                "example": {
                  "detail": "Sesión inválida o vencida."
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/grupos": {
      "get": {
        "tags": [
          "grupos"
        ],
        "summary": "Listar Grupos",
        "operationId": "listar_grupos_api_v1_grupos_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "fecha_nacimiento",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Fecha Nacimiento"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GrupoParaInscribir"
                  },
                  "title": "Response Listar Grupos Api V1 Grupos Get"
                }
              }
            }
          },
          "401": {
            "description": "Sesión inválida o vencida.",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Sesión inválida o vencida."
                },
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                }
              }
            }
          },
          "403": {
            "description": "No tenés permiso para esta operación.",
            "content": {
              "application/json": {
                "example": {
                  "detail": "No tenés permiso para esta operación."
                },
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/familias": {
      "get": {
        "tags": [
          "familias"
        ],
        "summary": "Buscar Familias",
        "operationId": "buscar_familias_api_v1_familias_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "apellido",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "title": "Apellido"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FamiliaEncontrada"
                  },
                  "title": "Response Buscar Familias Api V1 Familias Get"
                }
              }
            }
          },
          "401": {
            "description": "Sesión inválida o vencida.",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Sesión inválida o vencida."
                },
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                }
              }
            }
          },
          "403": {
            "description": "No tenés permiso para esta operación.",
            "content": {
              "application/json": {
                "example": {
                  "detail": "No tenés permiso para esta operación."
                },
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/personas": {
      "get": {
        "tags": [
          "personas"
        ],
        "summary": "Buscar Persona",
        "operationId": "buscar_persona_api_v1_personas_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "dni",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dni"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonaEncontrada"
                }
              }
            }
          },
          "401": {
            "description": "Sesión inválida o vencida.",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Sesión inválida o vencida."
                },
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                }
              }
            }
          },
          "403": {
            "description": "No tenés permiso para esta operación.",
            "content": {
              "application/json": {
                "example": {
                  "detail": "No tenés permiso para esta operación."
                },
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                }
              }
            }
          },
          "404": {
            "description": "No hay ninguna persona con ese DNI.",
            "content": {
              "application/json": {
                "example": {
                  "detail": "No hay ninguna persona con ese DNI."
                },
                "schema": {
                  "$ref": "#/components/schemas/MensajeError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/salud": {
      "get": {
        "tags": [
          "infraestructura"
        ],
        "summary": "Salud",
        "operationId": "salud_salud_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Salud Salud Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoriaFamilia": {
        "type": "string",
        "enum": [
          "socio",
          "empleado",
          "no_socio"
        ],
        "title": "CategoriaFamilia"
      },
      "FamiliaEncontrada": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "etiqueta": {
            "type": "string",
            "title": "Etiqueta"
          },
          "categoria": {
            "$ref": "#/components/schemas/CategoriaFamilia"
          }
        },
        "type": "object",
        "required": [
          "id",
          "etiqueta",
          "categoria"
        ],
        "title": "FamiliaEncontrada",
        "description": "Una familia de la busqueda por apellido. Solo id, etiqueta y categoria:\nla busqueda no filtra por grupo para el Profesor, asi que lo que se limita\nes lo que trae (ni alumnos, ni fechas, ni grupos, ni personas)."
      },
      "GrupoParaInscribir": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "turno": {
            "$ref": "#/components/schemas/Turno"
          },
          "nacimiento_desde": {
            "type": "string",
            "format": "date",
            "title": "Nacimiento Desde"
          },
          "nacimiento_hasta": {
            "type": "string",
            "format": "date",
            "title": "Nacimiento Hasta"
          },
          "sugerido": {
            "type": "boolean",
            "title": "Sugerido"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "turno",
          "nacimiento_desde",
          "nacimiento_hasta",
          "sugerido"
        ],
        "title": "GrupoParaInscribir",
        "description": "Un grupo donde se puede inscribir a un alumno, con la marca de\nsugerido segun la fecha de nacimiento consultada."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginEntrada": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginEntrada"
      },
      "LoginRespuesta": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioActual"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "usuario"
        ],
        "title": "LoginRespuesta"
      },
      "MensajeError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "MensajeError",
        "description": "Un rechazo con `detail` en castellano, que src/lib/api.ts muestra tal\ncual."
      },
      "PersonaEncontrada": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "apellido": {
            "type": "string",
            "title": "Apellido"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "apellido"
        ],
        "title": "PersonaEncontrada",
        "description": "La persona de la busqueda por DNI. Solo id, nombre y apellido: ni\ntelefono, ni DNI, ni familias."
      },
      "RolUsuario": {
        "type": "string",
        "enum": [
          "admin",
          "coordinador",
          "profesor"
        ],
        "title": "RolUsuario"
      },
      "Turno": {
        "type": "string",
        "enum": [
          "manana",
          "tarde"
        ],
        "title": "Turno"
      },
      "UsuarioActual": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "apellido": {
            "type": "string",
            "title": "Apellido"
          },
          "rol": {
            "$ref": "#/components/schemas/RolUsuario"
          },
          "debe_cambiar_password": {
            "type": "boolean",
            "title": "Debe Cambiar Password"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "nombre",
          "apellido",
          "rol",
          "debe_cambiar_password"
        ],
        "title": "UsuarioActual",
        "description": "El usuario que acaba de ingresar, tal como lo ve el mismo. Sin hash\nni contador de intentos."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
