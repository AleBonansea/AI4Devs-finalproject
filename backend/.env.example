# Copiar a .env y completar. El .env nunca entra en un commit.
DATABASE_URL=postgresql+psycopg://escuelita:escuelita@localhost:5432/escuelita
TEST_DATABASE_URL=postgresql+psycopg://escuelita:escuelita@localhost:5432/escuelita_test

# Clave de firma de los tokens. En produccion, un valor largo y aleatorio
# que no este en ningun repositorio.
SECRET_KEY=cambiar-esto-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origen del frontend en desarrollo.
CORS_ORIGINS=http://localhost:5173
